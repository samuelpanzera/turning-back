# Ambiente de Desenvolvimento Docker - PostgreSQL
ENV=development
PORT=8080
APP_NAME=turning-back

# Database - PostgreSQL (Desenvolvimento Docker)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=turning_back_user
DB_PASSWORD=turning_back_pass
DB_NAME=turning_back_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json